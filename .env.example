# Telegram bot (server-side — token brauzerga chiqmaydi)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=-1001234567890

# Static host (Netlify/GitHub Pages) uchun fallback — token client bundle ichida bo‘ladi
# VITE_TELEGRAM_BOT_TOKEN=
# VITE_TELEGRAM_CHAT_ID=

# ─── Guruh ID ni qanday olish ───────────────────────────────────────────────
# 1. @tianshang_order_bot botini Telegram guruhiga qo‘shing (admin qiling)
# 2. Guruhda istalgan xabar yozing (masalan: "test")
# 3. Brauzerda oching:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Javobda "chat":{"id":-1001234567890} ni toping — bu TELEGRAM_CHAT_ID
#    (guruh ID har doim minus bilan boshlanadi, masalan -100...)
#
# Vercel: Settings → Environment Variables → TELEGRAM_BOT_TOKEN va TELEGRAM_CHAT_ID
